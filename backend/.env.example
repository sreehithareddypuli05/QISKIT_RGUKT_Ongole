# PostgreSQL
# Local example:
DATABASE_URL=postgresql://qic_user:CHANGE_ME@localhost:5432/qic_db

# Security
QIC_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
QIC_TOKEN_MINUTES=240
ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# SMTP (required for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
